{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.10"
  },
  "type": "row",
  "preview": "layouts/herdr-t3.svg",
  "divider": {
    "width": 1,
    "color": "border"
  },
  "terminal_menu": "t3-menu",
  "floating": [
    {
      "id": "tabs-keys",
      "content": {
        "mod": "t3-tabs",
        "props": {
          "part": "keys"
        }
      },
      "edge": "bottom",
      "align": "end"
    },
    {
      "id": "new-chat-commands",
      "edge": "bottom",
      "align": "start",
      "content": {
        "mod": "new-chat",
        "props": {
          "role": "commands"
        }
      }
    }
  ],
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "t3-chrome"
          },
          "size": {
            "px": 40
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "stack",
          "active": "inbox",
          "children": [
            {
              "id": "lists",
              "type": "column",
              "children": [
                {
                  "id": "threads",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "content": {
                    "mod": "threads"
                  }
                }
              ]
            },
            {
              "id": "inbox",
              "type": "block",
              "content": {
                "mod": "t3-inbox",
                "props": {
                  "newMenu": "t3-new-menu",
                  "picker": "t3-picker",
                  "home": "t3-tabs.home",
                  "menu": "t3-menu"
                }
              }
            }
          ]
        },
        {
          "id": "usage-limits",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "usage-limits",
            "props": {
              "hidden": [
                "codex",
                "opencode",
                "pi"
              ],
              "showResetTime": true,
              "hiddenWindows": [
                "claude:session",
                "claude:weekly_scoped:Fable",
                "claude:weekly_scoped:Sonnet",
                "claude:weekly_scoped:Opus"
              ],
              "showBars": true,
              "wide": true
            }
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "t3-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 44
          }
        }
      ],
      "size": {
        "px": 256
      },
      "min": 208,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs-row",
          "type": "row",
          "size": {
            "px": 40
          },
          "resizable": false,
          "background": "chrome",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": {
                "weight": 1
              },
              "window_drag": true,
              "content": {
                "mod": "t3-tabs"
              }
            },
            {
              "id": "tabs-end",
              "type": "block",
              "size": {
                "px": 32
              },
              "window_drag": true,
              "content": {
                "mod": "t3-tabs",
                "props": {
                  "part": "end",
                  "block": "tabs-end"
                }
              }
            },
            {
              "id": "actions",
              "type": "block",
              "size": {
                "px": 28
              },
              "window_drag": true,
              "content": {
                "mod": "t3-actions",
                "props": {
                  "block": "actions",
                  "details": true
                }
              }
            },
            {
              "id": "window-end",
              "type": "block",
              "size": {
                "px": 0
              },
              "window_drag": true,
              "content": {
                "mod": "t3-tabs",
                "props": {
                  "part": "window",
                  "block": "window-end"
                }
              }
            },
            {
              "id": "tabs-end-inset",
              "type": "row",
              "size": {
                "px": 12
              },
              "window_drag": true,
              "children": []
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "work-main",
              "type": "stack",
              "active": "main",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "t3-pane"
                        },
                        "reveal": "always",
                        "height": 28,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 2,
                        "color": "background"
                      },
                      "focus": {
                        "width": 2,
                        "color": "background"
                      },
                      "radius": 8,
                      "gap": 8,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "home-main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "background": "background",
                      "border": {
                        "width": 2,
                        "color": "background"
                      },
                      "focus": {
                        "width": 2,
                        "color": "background"
                      },
                      "radius": 8,
                      "gap": 8,
                      "lone": true
                    }
                  }
                }
              ]
            }
          ],
          "padding": [
            0,
            8
          ],
          "gap": 8
        },
        {
          "id": "work-bottom-inset",
          "type": "row",
          "children": [
            {
              "id": "bar-measure",
              "type": "block",
              "size": {
                "weight": 1
              },
              "content": {
                "mod": "t3-tabs",
                "props": {
                  "part": "measure"
                }
              }
            }
          ],
          "size": {
            "px": 8
          }
        },
        {
          "id": "status",
          "type": "block",
          "hidden": true,
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ],
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "panel",
      "type": "column",
      "resizable": false,
      "hidden": true,
      "size": {
        "weight": 1
      },
      "min": 480,
      "children": [
        {
          "id": "panel-head",
          "type": "block",
          "size": {
            "px": 40
          },
          "padding": [
            0,
            12
          ],
          "window_drag": true,
          "content": {
            "mod": "t3-chrome",
            "props": {
              "part": "panel"
            }
          }
        },
        {
          "id": "panel-body",
          "type": "stack",
          "active": "panel-empty",
          "children": [
            {
              "id": "files",
              "type": "block",
              "content": {
                "mod": "t3-files"
              }
            },
            {
              "id": "panel-empty",
              "type": "block",
              "content": {
                "mod": "t3-chrome",
                "props": {
                  "part": "surface-empty"
                }
              }
            }
          ]
        }
      ],
      "background": "chrome"
    }
  ],
  "background": "canvas",
  "terminal_opacity": 0,
  "terminal_padding": [
    8,
    0
  ],
  "titlebar": "none",
  "traffic_lights": [
    16,
    12
  ]
}
